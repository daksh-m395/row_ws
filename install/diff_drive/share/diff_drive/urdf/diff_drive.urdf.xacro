<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diff_drive">

  <!-- ========================== Parameters ========================== -->
  <xacro:property name="chassis_length"   value="0.40"/>
  <xacro:property name="chassis_width"    value="0.30"/>
  <xacro:property name="chassis_height"   value="0.10"/>
  <xacro:property name="chassis_mass"     value="5.0"/>
  <xacro:property name="chassis_z"        value="0.05"/>  <!-- chassis center above base_link -->

  <xacro:property name="wheel_radius"     value="0.10"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_mass"       value="1.0"/>
  <xacro:property name="wheel_x"          value="-0.12"/> <!-- axle behind chassis center -->
  <xacro:property name="wheel_separation" value="0.36"/>

  <xacro:property name="caster_radius"    value="0.05"/>
  <xacro:property name="caster_mass"      value="0.5"/>
  <xacro:property name="caster_x"         value="0.14"/>

  <!-- base_link origin sits at the wheel axle height (wheel_radius above ground) -->

  <!-- ========================== Chassis ========================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.1 0.3 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass/12.0 * (chassis_width*chassis_width + chassis_height*chassis_height)}"
        iyy="${chassis_mass/12.0 * (chassis_length*chassis_length + chassis_height*chassis_height)}"
        izz="${chassis_mass/12.0 * (chassis_length*chassis_length + chassis_width*chassis_width)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- ========================== Drive wheels ========================== -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="${prefix}_wheel_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass/12.0 * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${wheel_mass/12.0 * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          izz="${wheel_mass/2.0 * wheel_radius*wheel_radius}"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>

    <!-- rpy=-pi/2 about X aligns the cylinder (and joint Z axis) with the robot's Y axis -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${wheel_x} ${reflect * wheel_separation/2} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ========================== Caster wheel ========================== -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${0.4 * caster_mass * caster_radius * caster_radius}"
        iyy="${0.4 * caster_mass * caster_radius * caster_radius}"
        izz="${0.4 * caster_mass * caster_radius * caster_radius}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${caster_x} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

  <!-- Frictionless caster: it just slides, the drive wheels do the steering -->
  <gazebo reference="caster_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ========================== Gazebo Fortress plugins ========================== -->
  <gazebo>
    <!-- Differential drive: subscribes to cmd_vel, publishes odometry + odom->base_link TF.
         Default gz topics (model name = diff_drive):
           /model/diff_drive/cmd_vel     (gz.msgs.Twist,    subscribed)
           /model/diff_drive/odometry    (gz.msgs.Odometry, published)
           /model/diff_drive/tf          (gz.msgs.Pose_V,   published)   -->
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <!-- Publishes wheel joint positions so robot_state_publisher / RViz can
         animate the wheels. Default gz topic:
           /world/diff_drive_world/model/diff_drive/joint_state (gz.msgs.Model) -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
    </plugin>
  </gazebo>

</robot>
